# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me

# --- Database ---
# SQLite is fine for local development. docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///dev.db

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Discovery and recommendations run once per pipeline; scoring runs once per query,
# so it gets the cheaper model. Override if you want everything on one model.
MODEL_DISCOVERY=claude-sonnet-5
MODEL_SCORING=claude-haiku-4-5
MODEL_RECOMMENDATION=claude-sonnet-5
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# --- DataForSEO (real search volume and keyword difficulty) ---
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password
DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_TIMEOUT_SECONDS=60

# --- Pipeline ---
DISCOVERY_TARGET_QUERIES=15
RECOMMENDATION_COUNT=5
RECOMMENDATION_INPUT_QUERIES=8

# --- Rate limiting ---
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
PIPELINE_RATE_LIMIT=5 per hour

LOG_LEVEL=INFO
